#!/usr/bin/env kbb
;; nbb replacement for the retired bb.edn `test` task (ADR-2607173000).
;; Run with: kbb --backend sci --classpath src:test run-murakumo-tests.cljs
(ns run-murakumo-tests
  (:require [clojure.test :as t]
            [kurashimori.murakumo-test]))

(let [r (t/run-tests 'kurashimori.murakumo-test)]
  (.exit js/process (if (zero? (+ (:fail r) (:error r))) 0 1)))
