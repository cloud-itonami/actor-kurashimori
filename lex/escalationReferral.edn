     {"type" "string",
      "maxLength" 1000,
      "description"
      "Why escalation (self-help stalled / representation needed); NOT a legal determination (G5)"},
     "targetRef"
     {"type" "string",
      "description"
      "AT-URI / rkey of the escalation remedyTarget (for center/ADR routes)"},
     "createdAt" {"type" "string", "format" "datetime"},
     "stateAlignedFlag"
     {"type" "boolean", "description" "G13 pass-through"}}}}}}
