    {"phase": "R2", "date": "post-R1 + 30-day public comment", "scope": "member SELF-SENDS; status_track + escalation live. No 代行.", "murakumoFleet": "reuben + gad", "gate": "Council Lv6+ ≥4 + 30-day public comment"},
    {"phase": "R3", "date": "post-R2 + Council Lv7+ unanimity + 司法書士法/行政書士法 clearance", "scope": "kurashimori_send active-outbound 代行 (本人同意ベース) for the member's own matter.", "murakumoFleet": "Full 10-node fleet", "gate": "Council Lv7+ unanimity + 司法書士法/行政書士法 clearance"}
  ],
